{
  "name": "intelliflow",
  "version": "0.1.0",
  "private": true,
  "description": "A keyboard-first model and reasoning switcher for AI chat websites.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node scripts/validate-manifest.mjs && node scripts/prepare-unpacked.mjs",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check .",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build"
  },
  "dependencies": {
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@wxt-dev/auto-icons": "1.1.2",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "^28.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wxt": "0.21.3"
  },
  "engines": {
    "node": ">=22"
  }
}
